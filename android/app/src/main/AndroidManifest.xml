<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.z.hack"
    android:versionCode="11"
    android:versionName="1.6.2">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />

    <!-- بررسی بروزرسانی و دریافت نسخه جدید از گیت‌هاب -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- نصب نسخه جدید از داخل برنامه (نصاب سیستم اندروید) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- خرید درون‌برنامه‌ای مایکت (ارتقا به نسخه پرو) -->
    <!-- هر دو دسترسی لازم است: سرویس خرید مایکت دسترسی com.android.vending.BILLING را هم بررسی می‌کند؛
         نبود آن باعث SecurityException در getBuyIntent می‌شود -->
    <uses-permission android:name="ir.mservices.market.BILLING" />
    <uses-permission android:name="com.android.vending.BILLING" />

    <!--
      ضروری برای اندروید ۱۱ به بالا (Package Visibility):
      بدون این تعریف، سیستم‌عامل وجود مایکت را از برنامه پنهان می‌کند و
      اتصال به سرویس خرید هرگز برقرار نمی‌شود (خطای «خرید ناموفق بود»). -->
    <queries>
        <package android:name="ir.mservices.market" />
        <intent>
            <action android:name="ir.mservices.market.InAppBillingService.BIND" />
        </intent>
    </queries>

    <application
        android:label="ضد هک"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- اشتراک‌گذاری امن فایل APK دانلودشده با نصاب سیستم -->
        <provider
            android:name=".ApkProvider"
            android:authorities="com.z.hack.update"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- ─── اجزای کتابخانه رسمی خرید مایکت (myket-billing-client) ─── -->
        <!-- آدرس سرویس و پکیج مایکت (معادل manifestPlaceholders مستندات رسمی) -->
        <meta-data android:name="market_id" android:value="ir.mservices.market" />
        <meta-data android:name="market_bind_address" android:value="ir.mservices.market.InAppBillingService.BIND" />

        <!-- صفحه میانی دریافت نتیجه خرید (onActivityResult داخلی کتابخانه) -->
        <activity
            android:name="ir.myket.billingclient.util.ProxyBillingActivity"
            android:exported="true"
            android:theme="@style/Theme.Transparent" />

        <!-- رسیور مسیر جایگزین ارتباط با مایکت (هنگام در دسترس نبودن سرویس) -->
        <receiver android:name="ir.myket.billingclient.util.IABReceiver" android:exported="true">
            <intent-filter>
                <action android:name="ir.mservices.market.ping" />
                <action android:name="ir.mservices.market.purchase" />
                <action android:name="ir.mservices.market.getPurchase" />
                <action android:name="ir.mservices.market.billingSupport" />
                <action android:name="ir.mservices.market.skuDetail" />
                <action android:name="ir.mservices.market.consume" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
